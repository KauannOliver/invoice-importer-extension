{
  "manifest_version": 3,
  "name": "e-Gate Importador de Notas (Excel)",
  "version": "1.0.0",
  "description": "Importa um XLSX e preenche automaticamente o formulário de notas no e-Gate (após login manual).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://egate.fcaservices.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://egate.fcaservices.com.br/*"
      ],
      "js": [
        "lib/xlsx.full.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}